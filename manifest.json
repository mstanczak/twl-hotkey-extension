{
  "manifest_version": 3,
  "name": "TWL Hotkey Enabler for Infor CloudSuite",
  "version": "1.1",
  "description": "Re-enables Ctrl+C, Ctrl+V, Ctrl+A, and other hotkeys on Infor CloudSuite sites.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.inforcloudsuite.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  }
}
